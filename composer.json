{
  "name": "pbd-kn/contao-tossncaptcha-bundle",
  "type": "contao-bundle",
  "description": "TossnCaptcha Captcha without Google",
  "homepage": "https://contao.org",
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Thorsten Gading",
      "email": "info@tossn.de"
    },
    {
      "name": "pbd-kn",
      "email": "pb-contao@gmx.de",
      "role": "Developer"
    }
  ],
  "support": {
    "email": "pb-contao@gmx.de",
    "issues": "https://github.com/pbd-kn/contao-tossncaptcha-bundle/issues",
    "source": "https://github.com/contao-tossncaptcha-bundle"
  },
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^4.13 || ^5.3",
    "symfony/config": "^5.4 || ^6.4",
    "symfony/dependency-injection": "^5.4 || ^6.4",
    "symfony/http-kernel": "^5.4 || ^6.4",
    "ext-gd": "*"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "contao/easy-coding-standard": "^4.2",
    "phpunit/phpunit": "^8.4|^9.0",
    "symfony/phpunit-bridge": "^4.4|^5.4|^6.0"
  },
  "autoload": {
    "psr-4": {
      "PBDKN\\ContaoCaptchaBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PBDKN\\ContaoCaptchaBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "PBDKN\\ContaoCaptchaBundle\\ContaoManager\\Plugin"
  },
  "scripts": {
    "cs-fixer": [
      "vendor\\bin\\ecs check src/ tests/ --fix --ansi"
    ]
  }
}
